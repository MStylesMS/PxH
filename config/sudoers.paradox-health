# Paradox Health Monitor — allowlisted NOPASSWD for user paradox
# Install: sudo install -m 440 config/sudoers.paradox-health /etc/sudoers.d/paradox-health
# Validate: sudo visudo -cf /etc/sudoers.d/paradox-health
#
# Only the commands PxH shells out to. Do not broaden without review.

paradox ALL=(root) NOPASSWD: /usr/bin/apt-get update
paradox ALL=(root) NOPASSWD: /usr/bin/apt-get -y upgrade
paradox ALL=(root) NOPASSWD: /usr/bin/apt-get clean
paradox ALL=(root) NOPASSWD: /usr/bin/systemctl start *
paradox ALL=(root) NOPASSWD: /usr/bin/systemctl stop *
paradox ALL=(root) NOPASSWD: /usr/bin/systemctl restart *
paradox ALL=(root) NOPASSWD: /sbin/shutdown -r +1 *
paradox ALL=(root) NOPASSWD: /usr/sbin/shutdown -r +1 *
