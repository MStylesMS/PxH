[Unit]
Description=Paradox Health Monitor (PxH)
Documentation=https://github.com/MStylesMS/PxH
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paradox
Group=paradox
WorkingDirectory=/opt/paradox/apps/PxH
Environment=NODE_ENV=production
# PAM auth helper + metrics need a normal home for IDE prune paths
Environment=HOME=/home/paradox
ExecStart=/usr/local/bin/node /opt/paradox/apps/PxH/dist/index.js --config /opt/paradox/config/pxh.ini
Restart=on-failure
RestartSec=5
SyslogIdentifier=pxh

[Install]
WantedBy=multi-user.target
